---
import "../styles/global.css";
import agents from "../data/agents.json";

interface Props {
  agentSlug: string;
  title: string;
  description: string;
}

const { agentSlug, title, description } = Astro.props;

const agentList = Object.values(agents as Record<string, any>).sort((a, b) => a.order - b.order);

const siteOrigin = Astro.site?.toString().replace(/\/$/, "") ?? "https://expert-flow-agents.vercel.app";
const canonical = `${siteOrigin}/${agentSlug}`;
// Per-agent OG kártyák a public/og/{slug}.png-ben (1200×630, accent-color glow + name + tagline).
// Fallback a sitewide og.png-re ha valamiért nincs per-agent verzió.
const ogImage = `${siteOrigin}/og/${agentSlug}.png`;

const currentAgent = agentList.find((a) => a.slug === agentSlug);
const agentName = currentAgent?.name ?? "Expert Flow Ügynökök";
const agentRole = currentAgent?.role ?? "Hat AI ügynök";
const ogImageAlt = `${agentName} — ${agentRole}`;

const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Expert Flow",
  "url": "https://expertflow.hu",
  "logo": `${siteOrigin}/og.png`,
  "sameAs": [
    "https://github.com/expertflow-attila",
    "https://github.com/Expert-Flow"
  ]
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Expert Flow Ügynökök", "item": siteOrigin },
    { "@type": "ListItem", "position": 2, "name": agentName, "item": canonical }
  ]
};
---
<!doctype html>
<html lang="hu" data-agent={agentSlug}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content="Expert Flow" />
    <meta name="theme-color" content="#0a0a0c" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="hu" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <!-- Font preconnect (Google Fonts) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="hu_HU" />
    <meta property="og:site_name" content="Expert Flow Ügynökök" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Structured data: Organization (sitewide) + BreadcrumbList -->
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <a href="#main" class="skip-link">Ugrás a tartalomhoz</a>

    <!-- Hermes-féle háttér effekt rétegek -->
    <div class="bg-fx-glow-tl" aria-hidden="true"></div>
    <div class="bg-fx-vignette" aria-hidden="true"></div>
    <div class="bg-fx-grain" aria-hidden="true"></div>

    <main id="main" class="shell">

      <!-- ── Header (desktop) ────────────────────────────────────── -->
      <header>
        <div class="g g-header">
          <a href="/orchestrator" class="gc gc-link" aria-label="Expert Flow Ügynökök — főoldal">
            <span class="brand-logo">
              <b>Expert</b><b>Flow</b>
            </span>
          </a>
          <a href="https://ev-landings.vercel.app" target="_blank" rel="noopener" class="gc gc-link">
            <span class="label-sm with-arrow">Kezdő eszközök</span>
          </a>
          <a href="https://github.com/expertflow-attila/expert-flow-agents" target="_blank" rel="noopener" class="gc gc-link">
            <span class="label-sm with-arrow">Dokumentáció</span>
          </a>
          <a href="https://expert-flow-start-2-0.vercel.app/" target="_blank" rel="noopener" class="gc gc-link">
            <span class="label-sm with-arrow">Előkészítő kurzus</span>
          </a>
          <div class="gc">
            <span class="label-sm">Közösség</span>
            <div class="socials-row">
              <a href="https://github.com/expertflow-attila" target="_blank" rel="noopener" aria-label="GitHub: expertflow-attila">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
              </a>
              <a href="https://github.com/Expert-Flow" target="_blank" rel="noopener" aria-label="GitHub org: Expert-Flow">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Mobile bar (≤1024px) — kompakt nav minden fő linkkel -->
        <div class="mobile-bar">
          <a href="/orchestrator" class="mobile-bar-brand" aria-label="Főoldal">
            <span class="brand-logo brand-logo--sm">
              <b>Expert</b><b>Flow</b>
            </span>
          </a>
          <nav class="mobile-nav" aria-label="Globális mobil navigáció">
            <a href="https://ev-landings.vercel.app" target="_blank" rel="noopener" aria-label="Kezdő eszközök (EV-Alap & EV-AIOS)">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
            </a>
            <a href="https://expert-flow-start-2-0.vercel.app/" target="_blank" rel="noopener" aria-label="Előkészítő kurzus">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
            </a>
            <a href="https://github.com/expertflow-attila/expert-flow-agents" target="_blank" rel="noopener" aria-label="GitHub repó">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
            </a>
          </nav>
        </div>

        <!-- ── Agent tab strip ───────────────────────────────────── -->
        <nav aria-label="Ügynökök">
        <div class="g g-tabs">
          {agentList.map((a) => (
            <a
              href={`/${a.slug}`}
              class={`gc gc-link gc-tab${a.slug === agentSlug ? " active" : ""}`}
              aria-current={a.slug === agentSlug ? "page" : undefined}
            >
              <span class="tab-name">{a.name}</span>
              <span class="tab-role">{a.role}</span>
            </a>
          ))}
        </div>
        </nav>
      </header>

      <slot />

    </main>

    <!-- ── Footer ── Landmark, kívül a <main>-on ──────────────── -->
    <footer class="g g-foot foot">
      <div class="gc">
        <span class="label-sm">Expert Flow Ügynökök</span>
        <span class="label-sm accent">v0.1.0</span>
      </div>
      <div class="gc">
        <a href="https://expertflow.hu" target="_blank" rel="noopener" class="label-sm with-arrow">expertflow.hu</a>
      </div>
      <div class="gc">
        <span class="label-sm dim">© 2026 · MIT License</span>
      </div>
    </footer>

    <script>
      // Copy buttons — clipboard API
      document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const target = btn.getAttribute("data-copy");
          if (!target) return;
          const el = document.querySelector(target) as HTMLElement | null;
          if (!el) return;
          try {
            await navigator.clipboard.writeText(el.innerText.trim());
            const original = btn.textContent;
            btn.classList.add("copied");
            btn.textContent = "Másolva";
            setTimeout(() => {
              btn.textContent = original;
              btn.classList.remove("copied");
            }, 1400);
          } catch (e) {
            console.error("Másolás sikertelen:", e);
          }
        });
      });

      // Reveal motion — IntersectionObserver fade-up + stagger (C10)
      const revealIO = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("in");
            revealIO.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15, rootMargin: "0px 0px -8% 0px" });
      document.querySelectorAll<HTMLElement>(".reveal").forEach((el) => revealIO.observe(el));

      // Animated terminal — type out lines one by one based on data-script
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      document.querySelectorAll<HTMLElement>("[data-terminal]").forEach((term) => {
        const script = JSON.parse(term.getAttribute("data-script") || "[]") as Array<{
          type: string;
          text: string;
          ms: number;
        }>;
        const body = term.querySelector(".term-body") as HTMLElement;
        if (!body) return;

        if (reduced) {
          body.innerHTML = script
            .map((s) => `<span class="term-line ${s.type}">${escapeHtml(s.text)}</span>`)
            .join("");
          return;
        }

        let i = 0;
        const cursor = document.createElement("span");
        cursor.className = "blink";
        body.appendChild(cursor);

        function next() {
          if (i >= script.length) return;
          const s = script[i++];
          const line = document.createElement("span");
          line.className = `term-line ${s.type}`;
          line.textContent = s.text;
          body.insertBefore(line, cursor);
          setTimeout(next, s.ms);
        }
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              setTimeout(next, 400);
              io.disconnect();
            }
          });
        }, { threshold: 0.3 });
        io.observe(term);
      });

      function escapeHtml(s: string) {
        return s.replace(/[&<>"']/g, (c) =>
          ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c] || c)
        );
      }
    </script>
  </body>
</html>
