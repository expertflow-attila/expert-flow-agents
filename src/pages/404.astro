---
import AgentLayout from "../layouts/AgentLayout.astro";
---

<AgentLayout
  agentSlug="orchestrator"
  title="404 — Expert Flow Ügynökök"
  description="Az oldal nem található. Térj vissza a flagship Orchestrator-hoz, vagy nézd meg az ügynök-stripet."
>

  <section class="hero">
    <div class="hero-eyebrow reveal">
      Expert Flow <span class="dot"></span> 404 <span class="dot"></span> Eltévedt parancs
    </div>
    <h1 class="reveal">Ez az oldal nem <em>létezik</em>.</h1>
    <p class="lede reveal">Lehet hogy elgépelted az URL-t, vagy egy régi link követett ide. A flagship Orchestrator-ral folytasd — onnan bármelyik ügynök egy kattintásra van.</p>

    <div class="cta-stack reveal">
      <div class="cta-card">
        <div class="cta-card-head">
          <span class="num">1. Vissza a flagshipre</span>
          <a href="/orchestrator" class="copy-btn" style="text-decoration: none;">/orchestrator →</a>
        </div>
        <code class="cta-code">A 6 ügynök főnöke. Magyar parancsból vezényli az ötöt.</code>
      </div>
      <div class="cta-card">
        <div class="cta-card-head">
          <span class="num">2. Vagy lépj át a kurzusra</span>
          <a href="https://expert-flow-start-2-0.vercel.app/" target="_blank" rel="noopener" class="copy-btn" style="text-decoration: none;">Előkészítő kurzus ↗</a>
        </div>
        <code class="cta-code">Ha most kezded — itt a belépő.</code>
      </div>
    </div>
  </section>

</AgentLayout>
