---
// A flagship: az Orchestrator a fő ügynök — index.astro vele azonos.
import AgentLayout from "../layouts/AgentLayout.astro";
import agentsData from "../data/agents.json";

const agent = (agentsData as any).orchestrator;

const repoCmd = "gh repo clone expertflow-attila/expert-flow-agents";
const promptId = "prompt-orchestrator";
const repoId = "repo-orchestrator";
const termJson = JSON.stringify(agent.terminalScript);

const siteOrigin = Astro.site?.toString().replace(/\/$/, "") ?? "https://expert-flow-agents.vercel.app";
const appJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Orchestrator — Expert Flow Igazgató",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web",
  "url": `${siteOrigin}/orchestrator`,
  "description": agent.lede,
  "inLanguage": "hu"
};
---

<AgentLayout
  agentSlug="orchestrator"
  title="Expert Flow Ügynökök — hat AI ügynök, egy havi átalány"
  description="Hat AI ügynök, amelyek az Expert Flow háttérműködését futtatják: ügyfélszerzés, pipeline, riportok, optimalizálás, számlázás, koordináció."
>

  <section class="hero">
    <div class="hero-eyebrow reveal">
      Expert Flow <span class="dot"></span> AI ügynök <span class="dot"></span> v0.1.0
    </div>
    <h1 class="reveal" set:html={agent.tagline}></h1>
    <p class="lede reveal">{agent.lede}</p>

    <div class="cta-stack reveal">
      <div class="cta-card liquid-glass">
        <div class="cta-card-head">
          <span class="num">1. Klónozás</span>
          <button type="button" class="copy-btn" data-copy={`#${repoId}`}>Másol</button>
        </div>
        <code id={repoId} class="cta-code"><span class="hl">{repoCmd}</span></code>
      </div>
      <div class="cta-card liquid-glass">
        <div class="cta-card-head">
          <span class="num">2. Próba prompt</span>
          <button type="button" class="copy-btn" data-copy={`#${promptId}`}>Másol</button>
        </div>
        <code id={promptId} class="cta-code"><span class="hl">{agent.promptExample}</span></code>
      </div>
    </div>
  </section>

  <div class="section-head reveal"><span class="label-lg">Lásd működés közben</span></div>
  <div class="demo-row">
    <div class="term-wrap">
      <div class="term" data-terminal data-script={termJson}>
        <div class="term-bar">
          <div class="dots"><span></span><span></span><span></span></div>
          <span class="term-title">orchestrator</span>
        </div>
        <div class="term-body"></div>
      </div>
    </div>
    <div class="art reveal" aria-hidden="true">
      <span class="art-motif" style="--motif: url(/agent-art/orchestrator.svg)"></span>
      <div class="art-letter">{agent.letter}</div>
      <div class="art-name">ORCHESTRATOR</div>
      <span class="art-label">Igazgató</span>
    </div>
  </div>

  <div class="section-head reveal"><span class="label-lg">Funkciók</span></div>
  <div class="g g-feat features-wrap">
    {agent.features.map((f: { title: string; body: string }, idx: number) => (
      <article class="feat-cell reveal" style={`transition-delay: ${idx * 60}ms`}>
        <h3 class="feat-eyebrow">{f.title}</h3>
        <p class="feat-body">{f.body}</p>
      </article>
    ))}
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(appJsonLd)} />

</AgentLayout>
